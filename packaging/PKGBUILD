# Nashira 的 Arch Linux 打包（.pkg.tar.zst）。
#
# 消費預先構建的 Compose app image——本 PKGBUILD 不跑 gradle（CI 已建好）：
#   ./gradlew desktopApp:createDistributable
#   NASHIRA_DIST="$PWD/desktopApp/build/compose/binaries/main/app/nashira" \
#     NASHIRA_ICONS="$PWD/desktopApp/packaging/hicolor/hicolor" makepkg -f
#
# 佈局鏡像 jpackage 的 deb/rpm：/opt/nashira + desktop entry + hicolor 圖標，
# 另加 /usr/bin/nashira 便利連結。app image 自帶 JRE，不需要 java-runtime。
pkgname=nashira
pkgver=${NASHIRA_VERSION:-0.1.5}
pkgrel=1
pkgdesc="Nashira — Matrix messenger for Android and Linux (Kotlin/Compose Multiplatform)"
depends=('xdg-utils')
options=('!strip' '!debug')
source=()
sha256sums=()

package() {
    local dist="${NASHIRA_DIST:?NASHIRA_DIST must point to the main/app/nashira app image}"
    local lib

    install -dm755 "${pkgdir}/opt/nashira"
    cp -a "${dist}/." "${pkgdir}/opt/nashira/"

    # 體積精簡：丟掉 jar 裡別的作業系統／別的架構的原生檔，再剝 .so 符號表。
    # 與 AUR 的 nashira-git 跑同一份腳本（$startdir 就是本目錄），兩邊產物一樣小。
    # 實測 v0.1.62：187MB → 172MB。腳本失敗或沒變小就让打包紅，別靜默出貨。
    local shrink="${startdir}/shrink-app-image.py" before after
    if [[ -f "${shrink}" ]]; then
        before=$(du -sm "${pkgdir}/opt/nashira" | cut -f1)
        python3 "${shrink}" "${pkgdir}/opt/nashira" \
            || { echo "::error::體積精簡腳本失敗" >&2; return 1; }
        after=$(du -sm "${pkgdir}/opt/nashira" | cut -f1)
        echo "==> 體積精簡：${before}MB → ${after}MB（省 $((before - after))MB）"
        (( after < before )) || { echo "::error::精簡後沒有變小" >&2; return 1; }
    else
        echo "::error::找不到 ${shrink}，拒絕出貨未精簡的包" >&2
        return 1
    fi

    lib="${pkgdir}/opt/nashira/lib"
    if [[ -f "${lib}/nashira.desktop" ]]; then
        install -Dm644 "${lib}/nashira.desktop" "${pkgdir}/usr/share/applications/nashira.desktop"
        sed -i 's|^Exec=.*|Exec=/opt/nashira/bin/nashira %u|' \
            "${pkgdir}/usr/share/applications/nashira.desktop"
        # SSO 應用內連結：註冊 nashira:// scheme（xdg-open 依此把 callback URL
        # 交回 app 的單實例 socket）。jpackage 生成的 .desktop 沒有 MimeType。
        if ! grep -q '^MimeType=' "${pkgdir}/usr/share/applications/nashira.desktop"; then
            printf 'MimeType=x-scheme-handler/nashira;\n' \
                >> "${pkgdir}/usr/share/applications/nashira.desktop"
        fi
    fi

    local icon="${NASHIRA_ICONS:-}"
    if [[ -d "${icon}" ]]; then
        # hicolor 全尺寸（16–512＋scalable SVG）：桌面環境按 DPI 挑最佳尺寸，
        # 不會拿 512 硬縮成 16 的糊圖
        install -dm755 "${pkgdir}/usr/share/icons/hicolor"
        cp -a "${icon}/." "${pkgdir}/usr/share/icons/hicolor/"
    elif [[ -f "${lib}/nashira.png" ]]; then
        install -Dm644 "${lib}/nashira.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/nashira.png"
    fi

    install -dm755 "${pkgdir}/usr/bin"
    ln -s /opt/nashira/bin/nashira "${pkgdir}/usr/bin/nashira"
}
